APP_NAME="AI Audit & Compliance Assistant"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:3000

# Docker ports
HTTP_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Database
POSTGRES_DB=audit_compliance
POSTGRES_USER=audit_user
POSTGRES_PASSWORD=<set-postgres-password>
DATABASE_URL=postgresql+psycopg://audit_user:<set-postgres-password>@postgres:5432/audit_compliance
DATABASE_CONNECT_RETRIES=3
DATABASE_RETRY_BACKOFF_SECONDS=0.5
DATABASE_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_TABLES=true

# Auth / JWT
JWT_SECRET_KEY=<set-long-random-jwt-secret>
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
PASSWORD_HASH_ALGORITHM=bcrypt
DEFAULT_ADMIN_EMAILS=

# Local runtime storage layout
STORAGE_ROOT=/app/storage
STORAGE_TEMP_DIR=temp
STORAGE_RULES_DIR=rules
STORAGE_COMPLIANCE_DIR=compliance
STORAGE_POLICIES_DIR=policies
TEMP_DOCUMENT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_MB=25
MAX_BULK_DOCUMENTS=2000
BULK_UPLOAD_MAX_RETRIES=2
BULK_READ_CHUNK_SIZE_BYTES=1048576
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_RULE_COLLECTION=compliance_rules
QDRANT_UPLOAD_COLLECTION=audit_document_chunks
QDRANT_COLLECTION=
QDRANT_TIMEOUT_SECONDS=30
QDRANT_RETRY_ATTEMPTS=3
QDRANT_RETRY_BACKOFF_SECONDS=0.4

# LLM routing
PRIMARY_LLM_PROVIDER=openrouter
PRIMARY_MODEL=google/gemini-2.5-flash
PRIMARY_LLM_MODEL=
LLM_PROVIDER=
LLM_MODEL=
SECONDARY_LLM_PROVIDER=
SECONDARY_MODEL=
SECONDARY_LLM_MODEL=
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_MODEL=
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=
TERTIARY_LLM_PROVIDER=
TERTIARY_LLM_MODEL=
FINAL_LLM_PROVIDER=
FINAL_LLM_MODEL=
LLM_FALLBACK_MODEL=

# OpenRouter
OPENROUTER_API_KEY=<set-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE="AI Audit & Compliance Assistant"
OPENROUTER_APP_NAME=

# Groq, optional
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Gemini, optional unless selected as primary/secondary/tertiary provider
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_BUDGET=

# LLM runtime controls
LLM_TIMEOUT_SECONDS=45
MAX_LLM_RETRIES=3
LLM_RETRY_ATTEMPTS=
LLM_RETRY_BACKOFF_SECONDS=1
LLM_BACKOFF_SECONDS=
JSON_REPAIR_ENABLED=true
LLM_MAX_COMPLETION_TOKENS=700
MAX_LLM_COMPLETION_TOKENS=
MAX_OUTPUT_TOKENS=900
LLM_MAX_OUTPUT_TOKENS=
MAX_CONTEXT_CHARS=7000
LLM_MAX_CONTEXT_CHARS=
LLM_MAX_RULES=3
MAX_LLM_RULES=
LLM_MAX_CHUNKS=5
MAX_LLM_CHUNKS=

# Embeddings / retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=
RERANKER_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=800
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP=120
CHUNK_OVERLAP_TOKENS=
TOP_K_VECTOR=25
VECTOR_TOP_K=
TOP_K_BM25=25
BM25_TOP_K=
FINAL_TOP_K=8
RERANK_TOP_K=
EMBEDDING_BATCH_SIZE=32
BATCH_SIZE=
SEMANTIC_SIMILARITY_THRESHOLD=0.2
MIN_SEMANTIC_SCORE=
MIN_CONFIDENCE_THRESHOLD=0.65
MIN_CONTEXT_CONFIDENCE=
ENABLE_RERANKING=false
ENABLE_RERANKER=
ENABLE_CONTEXT_VALIDATION=true
ENABLE_HYBRID_RETRIEVAL=true
PRELOAD_MODELS_ON_STARTUP=true

# S3 / AWS object storage
AWS_ACCESS_KEY_ID=<set-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<set-aws-secret-access-key>
AWS_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=
AWS_S3_BUCKET=
S3_RULE_BUCKET=<set-rule-bucket>
S3_TEMP_BUCKET=
S3_TEMP_UPLOAD_BUCKET=<set-temp-upload-bucket>
S3_REPORT_BUCKET=<set-report-bucket>
S3_TEMP_UPLOAD_PREFIX=temp-user-uploads/
S3_RULE_PREFIX=compliance-rules/
S3_REPORT_PREFIX=audit-reports/

# Rules / frontend runtime
RULE_CATEGORIES="HR,Security,Finance,Legal,Insurance,GDPR,Internal Policies"
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_API_URL=http://backend:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=60000
NEXT_PUBLIC_MAX_BULK_DOCUMENTS=2000
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
NEXT_PUBLIC_QUERY_STALE_TIME_MS=60000
NEXT_PUBLIC_QUERY_GC_TIME_MS=300000
DIGITAL_TWIN_CACHE_TTL_SECONDS=300
BACKEND_HEALTH_URL=http://127.0.0.1:8000/api/v1/health
