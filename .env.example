APP_NAME=AI-Driven Audit & Compliance Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# SQLite works for a direct local clone/run.
DATABASE_URL=sqlite:///./audit_compliance_local.db
# PostgreSQL option for docker-compose.dev.yml:
# DATABASE_URL=postgresql+psycopg://audit_user:audit_password@127.0.0.1:5432/audit_compliance

JWT_SECRET_KEY=change-this-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
PASSWORD_HASH_ALGORITHM=bcrypt
DEFAULT_ADMIN_EMAILS=

STORAGE_ROOT=storage
STORAGE_TEMP_DIR=temp
STORAGE_RULES_DIR=rules
STORAGE_COMPLIANCE_DIR=compliance
STORAGE_POLICIES_DIR=policies
TEMP_DOCUMENT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_MB=25
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_RULE_COLLECTION=compliance_rules
QDRANT_UPLOAD_COLLECTION=audit_document_chunks

LLM_PROVIDER=openrouter
SECONDARY_LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=Laguna M.1
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=AI-Driven Audit & Compliance Assistant
LLM_TIMEOUT_SECONDS=45
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1
MAX_OUTPUT_TOKENS=900
MAX_CONTEXT_CHARS=7000
LLM_MAX_RULES=3
LLM_MAX_CHUNKS=5
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_API_URL=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_BUDGET=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_VECTOR=25
TOP_K_BM25=25
FINAL_TOP_K=8
EMBEDDING_BATCH_SIZE=32
SEMANTIC_SIMILARITY_THRESHOLD=0.2
MIN_CONFIDENCE_THRESHOLD=0.65
ENABLE_RERANKING=false
ENABLE_CONTEXT_VALIDATION=true
ENABLE_HYBRID_RETRIEVAL=true
PRELOAD_MODELS_ON_STARTUP=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=audit-compliance-storage
S3_RULE_BUCKET=
S3_TEMP_UPLOAD_BUCKET=
S3_REPORT_BUCKET=
S3_TEMP_UPLOAD_PREFIX=temp-user-uploads/
S3_RULE_PREFIX=compliance-rules/
S3_REPORT_PREFIX=audit-reports/
RULE_CATEGORIES=HR,Security,Finance,Legal,Insurance,GDPR,Internal Policies
AUTO_CREATE_TABLES=true
