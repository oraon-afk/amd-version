APP_NAME=AI-Driven Audit & Compliance Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# SQLite works for a direct local clone/run.
DATABASE_URL=sqlite:///./audit_compliance_local.db
# PostgreSQL option for docker-compose.dev.yml:
# DATABASE_URL=postgresql+psycopg://audit_user:audit_password@127.0.0.1:5432/audit_compliance

JWT_SECRET_KEY=change-this-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
DEFAULT_ADMIN_EMAILS=

STORAGE_ROOT=storage
STORAGE_TEMP_DIR=temp
STORAGE_RULES_DIR=rules
STORAGE_COMPLIANCE_DIR=compliance
STORAGE_POLICIES_DIR=policies
TEMP_DOCUMENT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_MB=25
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_RULE_COLLECTION=compliance_rules
QDRANT_UPLOAD_COLLECTION=audit_document_chunks

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash-lite

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_RERANKING=false
ENABLE_CONTEXT_VALIDATION=true
ENABLE_HYBRID_RETRIEVAL=true
PRELOAD_MODELS_ON_STARTUP=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=audit-compliance-storage
S3_RULE_BUCKET=
S3_TEMP_UPLOAD_BUCKET=
S3_REPORT_BUCKET=
